{
  "name": "@weacademy/bytechain-shared",
  "version": "0.1.0",
  "description": "Shared TypeScript types, API response contracts and contract ABIs for the ByteChain Academy ecosystem.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bytechain",
    "weacademy",
    "types",
    "shared",
    "stellar",
    "soroban"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeAcademy/bytechain-shared.git"
  },
  "bugs": {
    "url": "https://github.com/WeAcademy/bytechain-shared/issues"
  },
  "homepage": "https://github.com/WeAcademy/bytechain-shared#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
